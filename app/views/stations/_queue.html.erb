<table>
    <tr>
      <th>i</th>
      <th>Song</th>
      <th>Artist</th>
      <th>Album</th>
      <th>Selector</th>
      <th>QPos</th>
    </tr>
  <% @station.queue_before([[User.where.not(position: nil).length * 5, 15].min, 5].max).each do |queue_entry| %>
    <tr>
      <td><%= queue_entry.position - @station.queue_pos %></td>
      <td><%= queue_entry.song.title %></td>
      <td><%= queue_entry.song.artist %></td>
      <td><%= queue_entry.song.album %></td>
      <td><%= queue_entry.selector.nil? ? "" : queue_entry.selector.username %></td>
      <td><%= queue_entry.position %></td>
    </tr>
  <% end %>
</table>
