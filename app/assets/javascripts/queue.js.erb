var queue_refresh_in_flight = false;
var queue_refresh_pending = false;
var queue_refresh_timer;

function update_next_up(user, letter) {
    $("#next-up").text(user
        ? `Next up... ${user.username} with '${letter}'`
        : `Next letter... '${letter}'`);
}

function refresh_queue() {
    const queue = $("#station-queue");
    if (!queue.length || document.hidden) return;
    if (queue_refresh_in_flight) {
        queue_refresh_pending = true;
        return;
    }

    queue_refresh_in_flight = true;
    $.ajax({
        url: `/stations/${queue.attr("data-station-id")}.json`,
        dataType: "json",
        cache: false,
        timeout: 10000
    }).done((state) => {
        queue.html(state.queue_html);
        update_next_up(state.next_user, state.next_letter);
    }).always(() => {
        queue_refresh_in_flight = false;
        if (queue_refresh_pending) {
            queue_refresh_pending = false;
            refresh_queue();
        }
    });
}

$(function() {
    if (queue_refresh_timer) window.clearInterval(queue_refresh_timer);
    refresh_queue();
    queue_refresh_timer = window.setInterval(refresh_queue, 3000);
    $(document).off("visibilitychange.queue").on("visibilitychange.queue", refresh_queue);
    $(window).off("focus.queue").on("focus.queue", refresh_queue);
});

function next_up(user, letter, notify_turn = true) {
    update_next_up(user, letter);
    refresh_queue();

    const on_queue = $("#station-queue").length > 0;
    const my_turn = user && logged_in() && current_user().id == user.id;
    if (my_turn && notify_turn && !(on_queue && !document.hidden && document.hasFocus())) {
        push(`It's your turn! Your letter is: ${letter}`, "/stations/1");
    }

    if (my_turn && !on_queue && /\/songs\/search\/?$/.test(window.location.pathname)) {
        location.reload();
    }
}

function next_song_js(queue_entry) {

    refresh_queue();
    console.log(`song.title: ${queue_entry.song.title}`);

    $("#now-playing-title").html(queue_entry.song.title);
    $("#now-playing-artist").html(queue_entry.song.artist);
    set_upvote_icon(false);

    // Remove the upvote handler for the old song.
    $("#now-playing-upvote").unbind("click");
    // And bind a handler for the new song.
    $("#now-playing-upvote").click(() => {
        toggle_upvote(queue_entry.id);
    });

    if (queue_entry.selector) {
        $("#now-playing-selector").html(`Chosen by ${queue_entry.selector.username}`);
        if (queue_entry.rec) {
            $("#now-playing-rec").html(
                `<i class="fa fa-spotify" style="font-size:1.5em;font-wieght:bold"></i>&nbsp;rec`
            )
        } else {
            $("#now-playing-rec").html("")
        }
    }
    console.log(`song.title2: ${queue_entry.song.title}`);
}

function update_timing(duration_ms, start_ms, queue_entry=null) {

    if (queue_entry) {
        console.log(`calling next_song_js: ${queue_entry}`);
        next_song_js(queue_entry);
    } else {
        console.log(`update_timing: ${duration_ms}, ${start_ms}`);
        setSongStats(duration_ms, start_ms);
    }
}
